{
  "name": "venice-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "node --env-file=.env test-chat.js",
    "test:jobs": "node server/test/jobs-race.test.mjs",
    "test:sheet": "node server/test/sheet.test.mjs",
    "stream": "node --env-file=.env stream-chat.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
